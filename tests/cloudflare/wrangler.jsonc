{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "ottodot-runtime-test",
  "main": "worker.fixture.ts",
  "compatibility_date": "2026-09-07",
  "durable_objects": {
    "bindings": [{ "name": "BOOKINGS", "class_name": "TestBookingDatabase" }]
  },
  "exports": {
    "TestBookingDatabase": { "type": "durable-object", "storage": "sqlite" }
  },
  "assets": {
    "directory": "../../dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
