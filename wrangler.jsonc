{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ottodot-trial-booking",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "BOOKINGS", "class_name": "BookingDatabase" }]
  },
  "exports": {
    "BookingDatabase": { "type": "durable-object", "storage": "sqlite" }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "rules": [{ "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }]
}
